# cluster/capi/values.env
#
# Inputs for the otel-arrow-demo workload cluster (Cluster API / CAPMOX). These
# are the values you edit for your environment; cluster.yaml and metallb.yaml
# above are pre-filled with the same placeholders so you can either edit them
# directly or template from this file.
#
# Cluster identity / networking
cluster_name=otel-arrow-demo
k8s_version=v1.35.3
pod_cidr=10.244.0.0/16
service_cidr=10.96.0.0/12

# OS / kernel — Ubuntu 24.04 + Kubernetes golden template (build with the
# proxmox-template workflow). source_node = the Proxmox node holding it;
# template_id = its VMID.
os_image=ubuntu-2404-kube
kernel_floor=6.8
source_node=pve-03
template_id=9000

# Control plane — single CP.
cp_replicas=1
cp_cpus=2
cp_memory_mib=4096
cp_disk_size_gb=50

# Workers — 3 replicas @ 16 GiB give the benchmark headroom under load.
worker_replicas=3
worker_cpus=4
worker_memory_mib=16384
worker_disk_size_gb=100

# ── IP layout (RFC 5737 documentation range — replace with real free IPs) ──
#   vip      .160            control-plane endpoint (kube-vip ARP)
#   nodes    .161-.170       CAPMOX IPAM node pool (1 CP + worker headroom)
#   metallb  .186-.218       LoadBalancer pool (disjoint from vip + node pool)
vip=192.0.2.160
node_pool_start=192.0.2.161
node_pool_end=192.0.2.170
metallb_pool_start=192.0.2.186
metallb_pool_end=192.0.2.218
gateway=192.0.2.1
dns_server=192.0.2.30

# ── Platform components (installed via CAAPH HelmChartProxy) ──
#   CNI:             Cilium (Istio-ambient compatible)
#   Mesh:            Istio ambient + Gateway API CRDs
#   LoadBalancer:    MetalLB (L2)
#   Default storage: csi-driver-nfs StorageClass (nfs-csi) — set your NFS server
#                    in cluster/capi/addons/csi-driver-nfs.yaml
